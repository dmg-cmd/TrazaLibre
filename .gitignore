# Carpetas de compilación y salida de artefactos
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Aa]rms/
[Aa]rms64/
x64/
x86/
[Aa]ny[Cc][Pp][Uu]/
build/

# Binarios y librerías generadas
*.exe
*.dll
*.so
*.dylib
*.pdb
*.ilk
*.msi
*.msix
*.msm
*.msp
*.lib
*.exp

# Archivos de depuración, logs y temporales
*.log
*.tmp
*.temp
*.bak
*.swp
*~
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Entorno, secretos y configuraciones locales
*.env
*.env.*
*.local
appsettings.*.local.json

# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# JetBrains Rider / Resharper
.idea/
_ReSharper*/
*.ReSharper

# Paquetes y dependencias
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.assets.json

# Sistema Operativo
$RECYCLE.BIN/
.DS_Store

# Recursos y bocetos del proyecto local
[Ii]magenes/
[Ii]mages/
